# Copy this file to .env and fill in your own values. Never commit .env.
# The app looks for .env in this folder first, then one folder up.

# Course key (MGT 409). Used only with model gpt-6-luna. Required.
PORTKEY_API_KEY=

# Optional live job sources (approved by the professor). Leave blank to use the sample jobs only.
# USAJobs federal jobs. Free key: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Adzuna jobs from many boards. Free key: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Google for Jobs via JSearch (includes LinkedIn and Indeed listings): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Real commute times by car, transit (WMATA, MTA, CTA, and other agencies), bike, or walking.
# Google Routes API key: https://developers.google.com/maps/documentation/routes
GOOGLE_MAPS_API_KEY=

# Optional: Postgres for sign-in accounts, so a profile and tracker follow the applicant to any device.
# Free database: https://neon.tech (copy the connection string). Leave blank locally: accounts are saved
# in server/data/accounts.local.json instead.
DATABASE_URL=
