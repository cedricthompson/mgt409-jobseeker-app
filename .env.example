# Copy this file to .env and fill in your own values. Never commit .env.
# The app looks for .env in this folder first, then one folder up.

# Course key (MGT 409). Used only with model gpt-6-luna. Required.
PORTKEY_API_KEY=

# Optional live job sources (approved by the professor). Leave blank to use the sample jobs only.
# USAJobs federal jobs. Free key: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Adzuna jobs from many boards. Free key: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
